CompileFlags:
  Add:
    # - -std=xxx        C语言标准
    # - -D xxx=xxx      预定义宏
    # - -U xxx          取消宏定义
    # - -I xxx          普通头文件搜索目录
    # - -include xxx.h  全局预包含头文件
    # - -isystem xxx    系统头文件搜索目录
    # - -target xxx     目标架构
    # - -mcpu=xxx       内核类型
    # - -ferror-limit=X 错误数量上限，0=不限制报错数量
    - -D__data=
    - -D__idata=
    - -D__xdata=
    - -D__pdata=
    - -D__code=
    - -D__at(x)=
    - -D__interrupt(x)=
    - -D__using(x)=
    - -D__sfr=extern volatile unsigned char
    - -D__sbit=extern volatile unsigned char
    - -D__bit=volatile unsigned char
    - -ferror-limit=0
    - -isystemD:\Toolchains\sdcc-4.6.0-x64\include  #SDCC 系统头文件搜索目录
  Remove: []
  CompilationDatabase: ./build/Debug
  Compiler: D:\Toolchains\sdcc-4.6.0-x64\bin\sdcc.exe  #SDCC 编译器路径